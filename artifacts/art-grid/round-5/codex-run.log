    font-size: 13px; padding: 6px 10px;
  }
}

/* Living residents: comfortable controls and quiet readable details. */
.pet-living { border-top: 1px solid var(--wood-light); margin-top: 8px; padding-top: 4px; }
.pet-living p { margin: 6px 0; overflow-wrap: anywhere; }
.living-cat-detail p { line-height: 1.5; }
.modal:has(.living-cat-detail) .modal-actions .pixel-btn { min-height: 44px; }

/* The journal shares the existing status strip so mobile café space stays intact. */
.cafe-status-bar { display: flex; flex-shrink: 0; min-width: 0; background: var(--cream); border-bottom: 3px solid var(--ink); }
.cafe-status-bar .reputation-bar { flex: 1; min-width: 0; border-bottom: 0; flex-wrap: wrap; }
.regular-guests-button { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; gap: 6px; min-height: 44px; padding: 6px 12px; color: var(--green-dark); background: var(--cream); border: 0; border-left: 2px solid var(--wood-light); font-size: 14px; }
.regular-guests-button:hover { background: #fff0cf; }
.regular-guests-button:focus-visible { outline: 3px solid var(--green-dark); outline-offset: -3px; }
