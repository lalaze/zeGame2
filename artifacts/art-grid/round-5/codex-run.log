  z-index: 7; left: calc(var(--edge-left) + 58px); right: auto; bottom: var(--edge-bottom);
  max-width: calc(100% - 210px); min-height: 44px; padding: 10px 16px;
  transform: none; animation: none; font-size: 17px; white-space: normal;
}
body.fullscreen-cafe .cafe-style-button {
  z-index: 7; top: auto; left: var(--edge-left); right: auto; bottom: calc(var(--edge-bottom) + 66px);
  min-height: 44px; max-width: 180px; margin: 0;
}
body.fullscreen-cafe .operation-status {
  position: absolute; z-index: 7; left: var(--edge-left); bottom: calc(var(--edge-bottom) + 124px);
  max-width: min(330px, calc(100% - 150px)); min-height: 44px; height: auto; margin: 0;
}
body.fullscreen-cafe .hint { display: none; }
body.fullscreen-cafe .edge-tools {
  position: absolute; z-index: 8; top: 50%; right: var(--edge-right);
  transform: translateY(-50%); display: flex; flex-direction: column; gap: 12px;
  max-height: calc(100% - 240px); overflow-y: auto; padding: 4px;
  scrollbar-width: thin; pointer-events: auto;
}
body.fullscreen-cafe .edge-tools button {
  display: flex; align-items: center; gap: 8px; min-height: 44px; min-width: 100px;
  margin: 0; padding: 8px 10px; border: 0; color: var(--ink);
  background: var(--paper-grain), var(--cream); box-shadow: var(--paper-card);
  font-size: 14px; text-align: left;
}
body.fullscreen-cafe .edge-tools button[aria-expanded="true"],
body.fullscreen-cafe .edge-tools button.active {
  color: var(--paper-light); background: var(--green-dark); box-shadow: var(--paper-card), inset 4px 0 var(--gold);
}
body.fullscreen-cafe .edge-tools .ui-pixel-icon { width: 20px; height: 20px; flex-shrink: 0; }
body.fullscreen-cafe button:focus-visible { outline: 3px solid var(--green-dark); outline-offset: 4px; }

/* The cabinet is independently positioned and owns exactly one scroll viewport. */
body.fullscreen-cafe #management-panel {
  position: absolute; z-index: 12; top: var(--edge-top); right: var(--edge-right);
  bottom: var(--edge-bottom); width: min(380px, calc(100% - var(--edge-left) - var(--edge-right)));
  min-height: 0; min-width: 0; display: flex; flex-direction: column; overflow: hidden;
  border: 3px solid var(--wood-lo); background: var(--paper-grain), var(--paper);
  box-shadow: inset 0 0 0 2px var(--wood-light), 0 0 0 2px var(--ink), -8px 8px 0 #39281f20;
}
body.fullscreen-cafe #management-panel:not([hidden]) { animation: cafe-drawer-in 160ms ease-out; }
body.fullscreen-cafe .drawer-header {
  display: flex; align-items: center; gap: 10px; flex-shrink: 0; min-height: 60px;
  padding: 6px 10px; background: var(--wood-planks), var(--wood); color: var(--paper-light);
}
body.fullscreen-cafe .drawer-header h2,
body.fullscreen-cafe .drawer-header strong { flex: 1; min-width: 0; margin: 0; font-size: 18px; }
body.fullscreen-cafe #drawer-close { margin-left: auto; min-width: 44px; min-height: 44px; font-size: 20px; }
body.fullscreen-cafe .drawer-pause { display: none; font-size: 12px; color: var(--paper-light); }
body.fullscreen-cafe.mobile-drawer-open .drawer-pause { display: block; }
body.fullscreen-cafe .panel .tabs {
  flex-shrink: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
  padding: 8px; gap: 8px;
}
body.fullscreen-cafe .panel .tab { min-height: 44px; padding: 6px 3px; margin: 0; font-size: 13px; }
body.fullscreen-cafe .panel .tab::before { display: inline-block; margin: 0 5px 0 0; }
