* {
  box-sizing: border-box;
}

[hidden] {
  display: none !important;
}

html,
body {
  margin: 0;
  height: 100%;
  overflow: hidden;
}

body {
  font-family: 'Pixelify Sans', 'Pixel ZH', ui-monospace, monospace;
  font-size: 16px;
  color: var(--ink);
  background-color: #302b28;
  background-image: repeating-linear-gradient(180deg, transparent 0 30px, #00000033 30px 33px),
    repeating-linear-gradient(90deg, transparent 0 93px, #0000002a 93px 96px),
    repeating-linear-gradient(90deg, transparent 0 47px, #ffffff08 47px 49px);
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
  touch-action: manipulation;
}

button {
  font: inherit;
  cursor: pointer;
}

kbd {
  font: inherit;
  background: var(--paper);
  padding: 0 4px;
  box-shadow: 0 2px 0 var(--muted);
}

/* Chinese: use the CJK pixel font for everything so Latin and Han glyphs match. */
html:lang(zh) body {
  font-family: 'Pixel ZH', 'Pixelify Sans', ui-monospace, monospace;
}

/* ------------------------------------------------------------ layout */

#app {
  height: 100dvh;
  display: flex;
  flex-direction: column;
  padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
}

.hud {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 14px;
  background: var(--wood-planks), var(--wood);
  color: var(--cream);
  text-shadow: 2px 2px 0 var(--ink);
  border-bottom: var(--px) solid var(--ink);
  box-shadow: inset 0 3px 0 var(--wood-hi), inset 0 -4px 0 var(--wood-lo);
  flex-shrink: 0;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 600;
  font-size: 18px;
  flex: 1;
  min-width: 0;
}

.brand-icon {
  width: 32px;
  height: 32px;
  image-rendering: pixelated;
}

.brand-name {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.money {
  text-align: center;
  line-height: 1.05;
  padding: 3px 16px 4px;
  background: var(--cream);
  box-shadow: var(--frame);
  text-shadow: none;
}

.coins {
  font-size: 26px;
  font-weight: 600;
  color: var(--gold);
  text-shadow: 2px 0 0 var(--ink), -2px 0 0 var(--ink), 0 2px 0 var(--ink), 0 -2px 0 var(--ink), 2px 3px 0 var(--ink);
}

.rate {
  font-size: 13px;
  color: var(--muted);
}

.hud-buttons {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 6px;
  white-space: nowrap;
}

.layout {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) clamp(330px, 32vw, 400px);
}

.layout.panel-collapsed {
  grid-template-columns: minmax(0, 1fr);
}

#panel-toggle {
  min-height: 36px;
}

#settings-btn {
  width: 36px;
  padding: 4px 0;
  font-family: 'Pixelify Sans', ui-monospace, monospace;
  flex-shrink: 0;
}

.stage {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 0;
  min-width: 0;
  overflow: hidden;
  padding: 14px;
}

.scene-wrap {
  position: relative;
  flex-shrink: 0;
}

.area-nav { position: absolute; top: 8px; left: 8px; z-index: 6; }
.area-plan-toggle { display: flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 8px; border: 0; background: var(--cream); color: var(--ink); box-shadow: var(--frame); font: inherit; font-size: 13px; cursor: pointer; }
.area-plan-toggle svg { width: 16px; height: 14px; flex-shrink: 0; }
.area-plan-toggle:hover { background: #fff2ce; }
.area-plan-toggle[aria-pressed="true"] { background: var(--green); color: #fff6da; }
.area-plan-toggle:focus-visible { outline: 3px solid var(--green-dark); outline-offset: 4px; }


