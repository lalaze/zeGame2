import { describe, expect, it } from 'vitest';
import { readFileSync } from 'node:fs';
const css = readFileSync('src/style.css', 'utf8');

// Read the final stylesheet values, rather than testing a second copy of the palette.
const variables = Object.fromEntries([...css.matchAll(/--([a-z-]+):\s*(#[0-9a-f]{6});/gi)].map(m => [m[1], m[2]]));
const luminance = (hex: string) => {
  const rgb = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map(c => c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  return rgb[0] * 0.2126 + rgb[1] * 0.7152 + rgb[2] * 0.0722;
};
const contrast = (a: string, b: string) => {
  const [lo, hi] = [luminance(a), luminance(b)].sort((x, y) => x - y);
  return (hi + 0.05) / (lo + 0.05);
};
const backgroundOf = (selector: string) => {
  const escaped = selector.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const rules = [...css.matchAll(new RegExp(`${escaped}\\s*\\{([^}]+)\\}`, 'g'))];
  return rules.at(-1)![1].match(/background:\s*(#[0-9a-f]{6})/)![1];
};

describe('Warm Pixel A small-label contrast', () => {
  it.each(['green', 'green-dark', 'wood', 'terracotta'])('keeps light action labels readable on %s', surface => {
    expect(contrast(variables['paper-light'], variables[surface])).toBeGreaterThanOrEqual(4.5);
  });
  it.each(['paper', 'cream'])('keeps muted and brass labels readable on %s', surface => {
    for (const ink of ['muted', 'brass-ink']) expect(contrast(variables[ink], variables[surface])).toBeGreaterThanOrEqual(4.5);
  });
  it.each([
    '.pixel-btn:hover:not(:disabled)',
    '.pixel-btn.danger:hover:not(:disabled)', '.day-hud .chip.close-btn:hover:not(:disabled)',
  ])('keeps %s labels readable', selector => {
    expect(contrast(variables['paper-light'], backgroundOf(selector))).toBeGreaterThanOrEqual(4.5);
  });
  it('keeps paper secondary buttons and disabled controls readable', () => {
    expect(contrast(variables['ink'], backgroundOf('.pixel-btn.ghost:hover:not(:disabled)'))).toBeGreaterThanOrEqual(4.5);
    expect(contrast(variables['disabled-ink'], variables['disabled-paper'])).toBeGreaterThanOrEqual(3);
  });
  it('keeps off-menu and unavailable copy opaque while the artwork stays subdued', () => {
    expect(css).toContain('.row.locked, .prep-row.off { opacity: 1; }');
    expect(css).toContain('.row.locked .name, .row.off-menu .name, .prep-row.off .prep-name { opacity: 1; color: var(--muted); }');
  });
  it('never paints a light generic hover background behind a selected chip label', () => {
    expect(css).toContain('.chip:hover:not(:disabled):not(.active):not([aria-pressed="true"])');
  });
});
{
  "name": "tiny-bean-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/subset-font.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/subset-font.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "font": "node scripts/subset-font.mjs",
    "balance": "vitest run scripts/balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:lab": "ECONOMY_LAB=1 vitest run scripts/economy-lab.test.ts --silent=false --disableConsoleIntercept",
    "balance:compare": "node scripts/compare-economy.mjs",
    "balance:frontier": "INVESTMENT_FRONTIER=1 vitest run scripts/investment-frontier.test.ts --silent=false --disableConsoleIntercept",
    "balance:long": "ECONOMY_LONG_HORIZON=1 vitest run scripts/economy-long-horizon.test.ts --silent=false --disableConsoleIntercept",
    "balance:long-supplement": "ECONOMY_LONG_HORIZON_SUPPLEMENT=1 vitest run scripts/economy-long-horizon-supplement.test.ts --silent=false --disableConsoleIntercept",
    "balance:fixed-clock": "FIXED_CLOCK=1 vitest run scripts/economy-fixed-clock.test.ts --silent=false --disableConsoleIntercept",
    "balance:recovery": "EMERGENCY_RECOVERY=1 EMERGENCY_RECOVERY_LABEL=emergency-recovery-v2 vitest run scripts/economy-recovery.test.ts --silent=false --disableConsoleIntercept",
    "balance:restore": "node scripts/restore-economy-evidence.mjs",
    "balance:routes": "vitest run scripts/cafe-style-balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:routes:full": "CAFE_STYLE_LAB=1 vitest run scripts/cafe-style-balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:routes:progression": "CAFESTYLE_PROGRESSION=1 vitest run scripts/cafe-style-progression.test.ts --silent=false --disableConsoleIntercept"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^4.2.1"
  }
}
@font-face {
  font-family: 'Pixel ZH';
  font-style: normal;
  font-weight: 400;
  font-display: block;
  /* Fusion Pixel by TakWolf (OFL 1.1), subset to the characters the game uses. */
  src: url('./assets/pixel-zh.woff2') format('woff2');
}

:root {
  /* Walnut, warm ivory, sage and brass match the café materials. */
  --ink: #49382e;
  --brown: #886448;
  --wood: #806047;
  --wood-light: #b98e64;
  --wood-hi: #dfbf8f;
  --wood-lo: #654b39;
  --paper: #e8dcc1;
  --cream: #faf1d9;
  --green: #66865c;
  --green-dark: #446849;
  --pink: #ef5d7a;
  --gold: #f3cf7d;
  --muted: #80694f;
  --px: 3px;
  --border: calc(-1 * var(--px)) 0 0 0 var(--ink), var(--px) 0 0 0 var(--ink), 0 calc(-1 * var(--px)) 0 0 var(--ink),
    0 var(--px) 0 0 var(--ink);
  /* An orange beveled frame inside the dark outline, like Stardew's menu boxes. */
  --frame: var(--border), inset 0 var(--px) 0 0 var(--wood-hi), inset 0 0 0 var(--px) var(--wood-light),
    inset 0 0 0 calc(var(--px) + 2px) var(--wood-lo);
  --wood-planks: repeating-linear-gradient(180deg, transparent 0 21px, #00000026 21px 24px),
    repeating-linear-gradient(90deg, transparent 0 46px, #0000001a 46px 48px);
  color-scheme: light;
}

.pet-intro { padding: 4px 6px 12px; }
.pet-intro h3, .pet-card h3 { margin: 4px 0; font-size: 17px; }
.pet-intro p, .pet-card p { margin: 8px 0; line-height: 1.6; }
.pet-summary { color: var(--green-dark); }
.pet-card { margin: 4px 3px 14px; padding: 12px; border: 2px solid var(--wood-light); background: var(--cream); }
.pet-card.adopted { border-color: var(--green); }
.pet-heading { display: flex; align-items: center; gap: 10px; }
.pet-heading img { width: 64px; height: 48px; image-rendering: pixelated; flex-shrink: 0; }
.pet-heading > div { flex: 1; min-width: 0; }
.pet-bonus { color: var(--green-dark); white-space: nowrap; }
.pet-card progress { width: 100%; height: 8px; accent-color: var(--green); margin-bottom: 12px; }
.pet-status { font-size: 13px; }
.pet-actions { display: flex; flex-wrap: wrap; gap: 8px; }
.pet-auto { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 13px; line-height: 1.5; }
.pet-auto input { accent-color: var(--green); width: 18px; height: 18px; }
.pet-tabs, .pet-filters { display: flex; flex-wrap: wrap; gap: 8px; padding: 4px 4px 12px; }
.pet-tabs .chip { flex: 1; }
.pet-tabs [aria-pressed="true"], .pet-filters [aria-pressed="true"] { background: var(--green-dark); color: var(--cream); }
.pet-catalog { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; padding: 4px 4px 16px; }
.pet-choice { min-width: 0; padding: 8px 3px; border: 2px solid var(--wood-light); color: var(--ink); background: var(--cream); display: flex; flex-direction: column; align-items: center; gap: 6px; }
.pet-choice[aria-pressed="true"] { border-color: var(--green-dark); box-shadow: inset 0 0 0 2px var(--green); background: #e3e8cb; }
.pet-choice img { width: 64px; height: 48px; image-rendering: pixelated; }
.pet-choice b { font-size: 12px; line-height: 1.5; }
.pet-choice span, .pet-choice small { font-size: 11px; line-height: 1.4; }
.pet-choice small { color: var(--green-dark); }
.pet-intro details summary { cursor: pointer; }
.promo-intro { padding: 4px 6px 12px; }
.promo-intro h3, .promo-active h3, .promo-platform h3 { margin: 4px 0; font-size: 17px; }
.promo-intro p, .promo-active p, .promo-card p { margin: 8px 0; line-height: 1.6; }
.promo-intro summary { cursor: pointer; }
.promo-summary, .promo-offer { color: var(--green-dark); }
.promo-active { margin: 4px 3px 16px; padding: 12px; border: 2px solid var(--green); background: #e3e8cb; }
.promo-active progress { width: 100%; height: 8px; margin-bottom: 12px; accent-color: var(--green); }
.promo-platform { display: flex; align-items: center; gap: 12px; margin: 16px 4px 10px; }
.promo-platform > span { display: grid; place-items: center; width: 44px; height: 44px; flex-shrink: 0; background: #60506d; color: #fff1d8; font-family: sans-serif; font-size: 24px; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--wood-light); }
.promo-platform.orange > span { background: #b95f39; }
.promo-platform p { margin: 4px 0; line-height: 1.5; }
