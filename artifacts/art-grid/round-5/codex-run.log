.panel-scroll { display: contents; }
@media (max-width: 860px) {
  .stage { height: min(360px, 44dvh); }
  .has-guide .stage { height: min(270px, 36dvh); }
  /* A furniture gesture deserves the whole café; finishing/cancelling restores
     management exactly where it was, without changing its saved collapse choice. */
  .layout:has(.scene-wrap.arranging) .panel { display: none; }
  .layout:has(.scene-wrap.arranging) .stage { flex: 1; height: auto; }
  .stage:has(.scene-wrap.arranging) .operation-status,
  .stage:has(.scene-wrap.arranging) .hint { display: none; }
  .modal:has(.rating-overview), .modal:has(.rating-report), .modal:has(.taste-overview) {
    max-height: calc(var(--usable-viewport-height, 100dvh) - 48px);
  }
  .hint { display: none; } /* Optional brewing is explained by help; never cover the room. */
}
@media (max-width: 860px) {
  .mobile-stage-controls .day-clock { flex: 1 1 60px; min-width: 0; }
}
@media (max-width: 860px) {
  .mobile-stage-controls:has(#open-btn:not([hidden])) { display: flex; align-items: center; gap: 8px; }
  .mobile-stage-controls:has(#open-btn:not([hidden])) .day-hud { flex: 0 1 105px; width: auto; background: none; box-shadow: none; }
  .mobile-stage-controls .open-btn { flex: 1; }
  .stage-stats { display: none; }
}
/* Scroll ownership follows the same explicit class as Panel, including during
   breakpoint changes; desktop keeps its original independent list viewport. */
.panel.mobile-panel .panel-scroll { display: block; flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scroll-padding-block: 8px; }
.panel.mobile-panel .panel-scroll > .list { overflow: visible; flex: none; }
@media (max-width: 860px) and (max-height: 500px) {
  #app { overflow-y: auto; overscroll-behavior: contain; }
  .layout { flex: 0 0 auto; min-height: 560px; }
  .panel { min-height: 240px; }
  .has-guide .stage, .stage { height: 260px; }
  .layout.panel-collapsed { min-height: 420px; }
}
@media (min-width: 600px) and (max-width: 860px) and (max-height: 500px) {
  .layout { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); min-height: 280px; height: 280px; }
  .panel { border-top: none; border-left: 3px solid var(--ink); }
  .has-guide .stage, .stage { height: auto; }
