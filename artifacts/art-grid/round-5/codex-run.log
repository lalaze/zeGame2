import fs from 'node:fs';
import { execFileSync } from 'node:child_process';
const directory = 'artifacts/art-grid/round-5';
const results = JSON.parse(fs.readFileSync(directory + '/vitest-results.json', 'utf8'));
const baselinePath = 'artifacts/art-grid/foundation-test-failures.txt';
const baseline = new Set(fs.readFileSync(baselinePath, 'utf8').trim().split('\\n'));
const failures = [];
for (const suite of results.testResults) {
  const filename = suite.name.replace(process.cwd() + '/', '');
  if (suite.status === 'failed' && "'!suite.assertionResults?.length) failures.push('"'[suite] ' + filename);
  for (const test of suite.assertionResults ?? []) if (test.status === 'failed') failures.push(filename + ' :: ' + test.fullName);
}
const newFailures = failures.filter(name => "'!baseline.has(name));
if (newFailures.length) throw Error(JSON.stringify(newFailures));
const css = fs.readFileSync('"'src/style.css', 'utf8');
const chrome = css.slice(css.lastIndexOf(':root {'));
const getTokens = source => Object.fromEntries([...source.matchAll(/--([a-z-]+):\\s*(#[\\da-f]{6});/gi)].map(match => [match[1], match[2]]));
const before = getTokens(execFileSync('git', ['show', 'HEAD:src/style.css'], { encoding: 'utf8' }));
const after = getTokens(css);
const luminance = hex => [1, 3, 5].map(offset => parseInt(hex.slice(offset, offset + 2), 16) / 255)
  .map(channel => channel <= .04045 ? channel / 12.92 : ((channel + .055) / 1.055) ** 2.4)
  .reduce((total, channel, index) => total + channel * [.2126, .7152, .0722][index], 0);
const contrast = (tokens, foreground, background) => {
  const pair = [luminance(tokens[foreground]), luminance(tokens[background])].sort((left, right) => left - right);
  return +((pair[1] + .05) / (pair[0] + .05)).toFixed(2);
};
const pairs = ['green', 'green-dark', 'wood', 'terracotta'].map(surface => ['paper-light', surface])
  .concat(['paper', 'cream'].flatMap(surface => ['ink', 'muted', 'brass-ink'].map(ink => [ink, surface])), [['disabled-ink', 'disabled-paper']]);
const contrastComparison = pairs.map(([foreground, background]) => ({ foreground, background, before: contrast(before, foreground, background), after: contrast(after, foreground, background) }));
if (contrastComparison.some(pair => pair.after < pair.before)) throw Error('Contrast regressed');
