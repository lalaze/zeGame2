const contrast = (tokens, fore, back) => { const pair = [lum(tokens[fore]),lum(tokens[back])].sort((a,b)=>a-b); return +((pair[1]+.05)/(pair[0]+.05)).toFixed(2); };
const pairs = ['green','green-dark','wood','terracotta'].map(surface=>['paper-light',surface]).concat(['paper','cream'].flatMap(surface=>['ink','muted','brass-ink'].map(ink=>[ink,surface])),[['disabled-ink','disabled-paper']]);
