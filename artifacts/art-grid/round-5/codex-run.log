  .row:has(.bake:not([hidden])) { display: grid; grid-template-columns: 40px minmax(0, 1fr); align-items: start; }
  .row:has(.bake:not([hidden])) .row-actions { grid-column: 1 / -1; flex-direction: row; gap: 10px; }
  .row:has(.bake:not([hidden])) .row-actions > button { flex: 1; }
  .row .bake { flex-wrap: wrap; white-space: normal; gap: 6px; }
