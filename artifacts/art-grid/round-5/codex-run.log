.tile-icon {
  width: 60px;
  height: 48px;
  image-rendering: pixelated;
}

.tile-name {
  font-size: 13px;
  font-weight: 600;
  line-height: 1.15;
  min-height: 2.3em;
  display: flex;
  align-items: center;
}

.tile-comfort {
  font-size: 12px;
  color: #b0601a;
}

.tile-btn {
  width: calc(100% - 6px);
  padding: 4px 6px;
  font-size: 13px;
}

.tile.equipped .tile-btn:disabled {
  background: var(--green-dark);
  color: #fff;
}

.tile-count {
  font-size: 11px;
  color: var(--muted);
  min-height: 1.2em;
}

.tile-btn + .tile-btn {
  margin-top: 4px;
}

.furniture .arrange-btn {
  margin: 0 3px 10px;
}

/*
 * Arranging furniture: instructions and buttons sit at the bottom, over the walkway
 * where nothing can be placed anyway. Only the buttons take taps; the rest of the
 * café stays tappable underneath.
 */
.arrange-bar {
  position: absolute;
  left: 50%;
  bottom: 8px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  pointer-events: none;
  z-index: 2;
}

.scene-wrap.has-front-passage .arrange-bar { bottom: 58px; }

.arrange-text {
  padding: 3px 8px;
  background: var(--cream);
  box-shadow: var(--border);
  font-size: 14px;
  font-weight: 600;
  white-space: nowrap;
  opacity: 0.92;
}

.arrange-actions {
  display: flex;
  gap: 6px;
  pointer-events: auto;
}

.scene-wrap.arranging .day-hud,
.scene-wrap.arranging .open-btn,
.scene-wrap.arranging ~ .hint {
  display: none;
}

.scene-wrap.arranging canvas {
  cursor: crosshair;
}
