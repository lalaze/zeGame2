}
@media (max-width: 860px) {
  .guide-actions { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .guide-actions button { margin: 0; padding: 4px; overflow-wrap: anywhere; }
  .mobile-stage-controls:has(#open-btn:not([hidden])) .day-hud { background: var(--cream); color: var(--ink); }
}
@media (max-width: 860px) {
