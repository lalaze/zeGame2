import { describe, expect, it } from 'vitest';
import { readFileSync } from 'node:fs';
const css = readFileSync('src/style.css', 'utf8');

// Read the final stylesheet values, rather than testing a second copy of the palette.
const variables = Object.fromEntries([...css.matchAll(/--([a-z-]+):\s*(#[0-9a-f]{6});/gi)].map(m => [m[1], m[2]]));
const luminance = (hex: string) => {
  const rgb = [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255)
    .map(c => c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  return rgb[0] * 0.2126 + rgb[1] * 0.7152 + rgb[2] * 0.0722;
};
const contrast = (a: string, b: string) => {
  const [lo, hi] = [luminance(a), luminance(b)].sort((x, y) => x - y);
  return (hi + 0.05) / (lo + 0.05);
};
const backgroundOf = (selector: string) => {
  const escaped = selector.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  const rules = [...css.matchAll(new RegExp(`${escaped}\\s*\\{([^}]+)\\}`, 'g'))];
  return rules.at(-1)![1].match(/background:\s*(#[0-9a-f]{6})/)![1];
};

describe('Warm Pixel A small-label contrast', () => {
  it.each(['green', 'green-dark', 'wood', 'terracotta'])('keeps light action labels readable on %s', surface => {
    expect(contrast(variables['paper-light'], variables[surface])).toBeGreaterThanOrEqual(4.5);
  });
  it.each(['paper', 'cream'])('keeps muted and brass labels readable on %s', surface => {
    for (const ink of ['muted', 'brass-ink']) expect(contrast(variables[ink], variables[surface])).toBeGreaterThanOrEqual(4.5);
  });
  it.each([
    '.pixel-btn:hover:not(:disabled)',
    '.pixel-btn.danger:hover:not(:disabled)', '.day-hud .chip.close-btn:hover:not(:disabled)',
  ])('keeps %s labels readable', selector => {
    expect(contrast(variables['paper-light'], backgroundOf(selector))).toBeGreaterThanOrEqual(4.5);
  });
  it('keeps paper secondary buttons and disabled controls readable', () => {
    expect(contrast(variables['ink'], backgroundOf('.pixel-btn.ghost:hover:not(:disabled)'))).toBeGreaterThanOrEqual(4.5);
    expect(contrast(variables['disabled-ink'], variables['disabled-paper'])).toBeGreaterThanOrEqual(3);
  });
  it('keeps off-menu and unavailable copy opaque while the artwork stays subdued', () => {
    expect(css).toContain('.row.locked, .prep-row.off { opacity: 1; }');
    expect(css).toContain('.row.locked .name, .row.off-menu .name, .prep-row.off .prep-name { opacity: 1; color: var(--muted); }');
  });
  it('never paints a light generic hover background behind a selected chip label', () => {
    expect(css).toContain('.chip:hover:not(:disabled):not(.active):not([aria-pressed="true"])');
  });
});

/* Quiet paper / walnut / matte sage materials. Geometry and game state remain
   owned by the existing responsive layout and control components above. */
.pixel-btn, .chip, .tab {
  min-width: 44px; min-height: 44px; border-radius: 0;
  text-shadow: none; box-shadow: var(--button-edge);
}
.pixel-btn { background: var(--green); color: var(--paper-light); }
.pixel-btn:hover:not(:disabled) { background: #627354; filter: none; }
.pixel-btn.ghost { background: var(--cream); color: var(--ink); text-shadow: none; }
.pixel-btn.ghost:hover:not(:disabled) { background: #fff9ec; color: var(--ink); }
.pixel-btn.danger, .day-hud .close-btn { background: var(--terracotta); color: var(--paper-light); text-shadow: none; }
.pixel-btn.danger:hover:not(:disabled),
.day-hud .chip.close-btn:hover:not(:disabled) { background: #9b5140; color: var(--paper-light); }
.pixel-btn:active:not(:disabled), .chip:active:not(:disabled), .tab:active:not(:disabled) {
  box-shadow: var(--border), inset 0 1px 0 #49342830;
  translate: 0 1px;
}
.pixel-btn:active:not(:disabled) { transform: none; }
.pixel-btn:disabled, .chip:disabled, .menu-toggle:disabled {
  background: var(--disabled-paper); color: var(--disabled-ink);
  box-shadow: 0 0 0 1px #a9967d; text-shadow: none; opacity: 1;
  cursor: not-allowed; translate: none;
}
.chip, .tab { background: var(--cream); color: var(--ink); text-shadow: none; }
.tab:hover:not(.active) { background: var(--paper-light); }
.tab.active, .chip.active, .menu-toggle.active,
.pet-tabs [aria-pressed="true"], .pet-filters [aria-pressed="true"] {
  background: var(--green); color: var(--paper-light); text-shadow: none;
  box-shadow: var(--border), inset 0 -3px 0 var(--paper-light);
}
.tab.active { z-index: 1; }
.chip:hover:not(:disabled):not(.active):not([aria-pressed="true"]) { background: var(--paper-light); }
.tab.active:hover, .chip.active:hover:not(:disabled) { background: var(--green-dark); }
:is(.pixel-btn,.chip,.tab,.theme,.pet-choice,.style-choice):focus-visible,
body.fullscreen-cafe button:focus-visible {
  outline: 2px solid var(--paper-light); outline-offset: 2px;
  box-shadow: 0 0 0 5px var(--green-dark);
}
.panel, body.fullscreen-cafe #management-panel {
  background: var(--paper-grain), var(--paper);
  border: 2px solid var(--wood-lo);
  box-shadow: inset 0 0 0 1px var(--wood-light), 0 3px 0 #49342830;
}
.tabs, body.fullscreen-cafe .drawer-header {
  background: var(--wood-planks), var(--wood);
  box-shadow: none; text-shadow: none;
}
.tabs { border-bottom: 1px solid var(--wood-lo); }
body.fullscreen-cafe .panel .tab { box-shadow: var(--border); }
body.fullscreen-cafe .panel .tab.active { box-shadow: var(--border), inset 0 -3px var(--paper-light); }
body.fullscreen-cafe .drawer-balance {
  background: transparent; color: var(--paper-light); text-shadow: none;
  box-shadow: none; border: 1px solid #c8ac8766;
  text-decoration: underline; text-underline-offset: 4px; padding: 7px 9px;
}
body.fullscreen-cafe .drawer-balance:hover:not(:disabled) { background: #ffffff0d; }
body.fullscreen-cafe .drawer-balance:active:not(:disabled) { background: #00000012; box-shadow: none; }
body.fullscreen-cafe #drawer-close { background: var(--cream); color: var(--ink); }
body.fullscreen-cafe #drawer-close:hover { background: var(--paper-light); }
body.fullscreen-cafe .edge-tools button {
  background: var(--paper-grain), var(--cream); color: var(--ink);
  box-shadow: var(--button-edge); text-shadow: none;
}
body.fullscreen-cafe .edge-tools button:hover { background: var(--paper-light); }
body.fullscreen-cafe .edge-tools button[aria-expanded="true"],
body.fullscreen-cafe .edge-tools button.active {
  background: var(--green); color: var(--paper-light);
  box-shadow: var(--border), inset 3px 0 var(--paper-light);
}
body.fullscreen-cafe .edge-tools button:active { translate: 0 1px; }
body.fullscreen-cafe .edge-tools button:focus-visible,
body.fullscreen-cafe .drawer-balance:focus-visible,
body.fullscreen-cafe .panel .tab:focus-visible {
  outline: 2px solid var(--paper-light); outline-offset: 2px;
  box-shadow: 0 0 0 5px var(--green-dark);
}
.row, .pet-card, .promo-card, .regular-profile, .signature-card, .style-current,
.signature-summary, .taste-overview, .rating-overview, .rating-report {
  background: var(--cream); border-color: var(--paper-shadow); box-shadow: var(--paper-card);
}
.row.new { background: var(--cream); }
.row.low { box-shadow: var(--paper-card), inset 3px 0 var(--terracotta); }
.goal, .toast { background: var(--cream); box-shadow: var(--paper-card); }
.goal { border-top: 2px solid var(--wood-light); }
.goal.done { background: #e9eddd; }
.bar { background: var(--paper-shadow); box-shadow: 0 0 0 1px var(--brass-shadow); }
.bar i { background: var(--green); }
.row.low .bar i { background: var(--terracotta); }
.pixel-btn.restock.is-complete {
  background: #e9eddd; color: var(--green-dark); border: 1px solid #bcc6aa;
  box-shadow: none; cursor: default; text-align: left;
}
.restock-reason { margin: 8px 3px 0; color: var(--muted); }
.pixel-box {
  background: var(--paper-grain), var(--cream);
  box-shadow: 0 0 0 1px var(--wood-light), 0 0 0 5px var(--wood), 0 0 0 6px var(--wood-lo), 0 7px 0 6px #49342830;
}
body.fullscreen-cafe .hud .brand {
  background: var(--wood-planks), var(--wood); box-shadow: var(--frame); text-shadow: none;
}
body.fullscreen-cafe .day-hud, body.fullscreen-cafe .hud .money,
.area-plan-toggle, .cafe-style-button, .area-arrow-sign {
  background: var(--cream); box-shadow: var(--paper-card);
}
body.fullscreen-cafe #settings-btn { min-width: 44px; min-height: 44px; }
body.fullscreen-cafe .first-service { border: 1px solid var(--paper-shadow); box-shadow: var(--paper-card); }
.money-details { min-height: 44px; min-width: 44px; }
@media (prefers-reduced-motion: reduce) {
  .pixel-btn:active:not(:disabled), .chip:active:not(:disabled),
  .tab:active:not(:disabled), body.fullscreen-cafe .edge-tools button:active { translate: none; }
}

/* Ends the business day, which brings up the settlement. */
.day-hud .close-btn {
  margin-left: 2px;
  padding: 0 8px;
  font-size: 13px;
  background: #b5453a;
  color: #fdf6ec;
}

/* The big "prepare the menu" button, centered at the bottom of the café. */
.open-btn {
  position: absolute;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  padding: 10px 22px;
  font-size: 20px;
  font-weight: 600;
  white-space: nowrap;
  animation: open-bob 1.4s steps(2) infinite;
}

@keyframes open-bob-corner {
  50% {
    transform: translateY(-3px);
  }
}

@keyframes open-bob {
  50% {
    transform: translate(-50%, -3px);
  }
}

#scene {
  display: block;
  image-rendering: pixelated;
  box-shadow: 0 0 0 3px var(--ink), 0 0 0 7px var(--wood-light), 0 0 0 8px var(--wood-hi), 0 0 0 10px var(--ink),
    0 6px 0 10px #00000055;
  cursor: pointer;
  touch-action: manipulation;
}

.hint {
  position: absolute;
  /* Above the day HUD, which runs along the bottom with the Close shop button. */
  bottom: 46px;
  left: 50%;
  transform: translateX(-50%);
  background: var(--cream);
  padding: 4px 10px;
  box-shadow: var(--border);
  font-size: 14px;
  white-space: nowrap;
  pointer-events: none;
  animation: bob 1.2s steps(2) infinite;
}

@keyframes bob {
  50% {
    transform: translate(-50%, -3px);
  }
}

/* ------------------------------------------------------------ panel */

.panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: var(--paper);
  border-left: var(--px) solid var(--ink);
  box-shadow: inset 4px 0 0 var(--wood-light), inset 6px 0 0 var(--wood-lo);
}

.tabs {
  display: flex;
  gap: 0;
  padding: 8px 6px 0 10px;
  background: var(--wood-planks), var(--wood);
  border-bottom: var(--px) solid var(--ink);
}

.tab {
  flex: 1;
  min-width: 0;
  padding: 8px 2px 6px;
  border: none;
  background: var(--wood-light);
  color: var(--cream);
  font-size: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 600;
  text-shadow: 2px 2px 0 var(--ink);
  box-shadow: 0 -3px 0 0 var(--ink), -3px 0 0 0 var(--ink), 3px 0 0 0 var(--ink), inset 0 3px 0 var(--wood-hi);
  margin: 3px 3px 0;
}

.tab.active {
  background: var(--paper);
  color: var(--ink);
  text-shadow: none;
  box-shadow: 0 -3px 0 0 var(--ink), -3px 0 0 0 var(--ink), 3px 0 0 0 var(--ink), inset 0 3px 0 var(--cream),
    0 3px 0 0 var(--paper);
  position: relative;
  z-index: 1;
}

.buy-amount {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px 4px;
  font-size: 14px;
  color: var(--muted);
}

.chip {
  border: none;
  padding: 2px 10px;
  background: var(--cream);
  color: var(--ink);
  box-shadow: var(--border);
  margin: 0 4px;
}

.chip.active {
  background: var(--ink);
  color: var(--gold);
}

.list {
  flex: 1;
  overflow-y: auto;
  padding: 8px 12px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  overscroll-behavior: contain;
}

.row {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 11px;
  margin: 3px;
  background: var(--cream);
  box-shadow: var(--frame);
}

.row.new {
  background: #f7edd5;
}

.row.locked {
  opacity: 0.55;
}

.row.pop {
  animation: pop 0.25s steps(3);
}

@keyframes pop {
  50% {
    transform: scale(1.03);
  }
}

.row .icon {
  width: 40px;
  height: 40px;
  object-fit: contain;
  image-rendering: pixelated;
  flex-shrink: 0;
}

.icon.mystery {
  display: grid;
  place-items: center;
  font-size: 24px;
  background: var(--paper);
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-weight: 600;
  font-size: 16px;
}

.lv {
  font-weight: 400;
  font-size: 13px;
  color: var(--muted);
  margin-left: 4px;
}

.sub {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.2;
}

.bar {
.pixel-btn:focus-visible, .chip:focus-visible, .tab:focus-visible, .theme:focus-visible,
.pet-choice:focus-visible, .style-choice:focus-visible {
  outline: 2px solid var(--paper-light);
  outline-offset: 3px;
  box-shadow: var(--border), 0 0 0 5px var(--green-dark);
}
.taste-chip { background: #e6e4c9; border-color: #8f956a; box-shadow: inset 1px 1px var(--paper-light); }
.taste-chip:hover, .taste-chip:focus-visible { background: #f1eed6; outline-color: var(--green-dark); }

/* Dialogs and reports: paper within a carved timber surround. */
.modal-overlay, .onboard-overlay { background: #39281fbf; }
.pixel-box {
  background: var(--paper-grain), var(--cream);
  box-shadow: inset 0 0 0 2px var(--paper-light), 0 0 0 2px var(--brass-shadow),
    0 0 0 4px var(--wood-hi), 0 0 0 9px var(--wood), 0 0 0 10px var(--wood-light),
    0 0 0 12px var(--ink), 4px 9px 0 12px #39281f45;
}
.modal h2 { color: var(--wood-lo); border-bottom: 2px solid var(--paper-shadow); padding-bottom: 10px; }
.modal-actions { border-top: 1px solid var(--paper-shadow); padding-top: 10px; }
.big-money { color: var(--brass-shadow); text-shadow: 1px 1px var(--brass-light); }
.report-profit { background: var(--paper); box-shadow: var(--paper-card); }
.stats { line-height: 1.45; }
.prep-row { background: var(--cream); box-shadow: 0 0 0 1px var(--brass-shadow), inset 1px 1px var(--paper-light); }
.prep-row.low { background: #ead1b2; box-shadow: 0 0 0 1px var(--terracotta), inset 3px 0 var(--terracotta); }
.prep-row.off { opacity: .66; }
.prep-starter, .prep-bakery-hint, .prep-style, .style-next, .promo-active { background: #e0e2c4; border-color: var(--green); }
.prep-details, .report-details, .style-picker, .style-details { border-color: var(--paper-shadow); background: #fff5dc35; }
.toast, .goal { background: var(--paper-grain), var(--cream); box-shadow: var(--frame), 2px 3px #54342538; }
.goal.done { background-color: #e0e2c4; }
@keyframes goal-glow { 50% { background-color: #edf0d7; } }
.pixel-input, .bake-input, .signature-naming input, .signature-research > input, .signature-dose select {
  background: var(--paper-light);
  border-radius: 0;
  color: var(--ink);
  border-color: var(--brass-shadow);
  box-shadow: inset 1px 2px var(--paper-shadow);
}
.pixel-input:focus, .bake-input:focus, .signature-naming input:focus, .signature-dose select:focus {
  outline: 2px solid var(--green-dark);
  outline-offset: 2px;
}
.review-stars { color: var(--paper-shadow); text-shadow: 1px 1px var(--brass-shadow); }
.review-stars > span { color: var(--gold); }
.guest-review { border-bottom-color: var(--paper-shadow); }

/* Shared collected-object trays, portraits and selection corners. */
.tile, .pet-choice, .theme, .style-choice {
  background: var(--paper-grain), var(--cream);
  border-color: var(--brass-shadow);
  box-shadow: inset 1px 1px var(--paper-light), inset -1px -1px var(--paper-shadow);
}
.tile.equipped, .pet-choice[aria-pressed="true"], .style-choice[aria-pressed="true"] {
  background-color: #e0e2c4;
  border-color: var(--green-dark);
  box-shadow: inset 3px 0 var(--green), inset 0 -2px var(--green), inset 1px 1px var(--paper-light);
}
.theme.active { background-color: #e0e2c4; box-shadow: var(--border), 0 0 0 6px var(--gold); }
.char-preview, .profile-row { background: var(--paper-grain), var(--paper); }
.char-preview { box-shadow: var(--frame); }
.ob-dots i { background: var(--paper); box-shadow: 0 0 0 1px var(--brass-shadow); }
.ob-dots i.done { background: var(--green); }
.ob-dots i.on { background: var(--gold); box-shadow: 0 0 0 2px var(--ink), inset 1px 1px var(--brass-light); }
.swatch.active { box-shadow: 0 0 0 2px var(--ink), 0 0 0 5px var(--gold), inset 1px 1px var(--paper-light); }
.opening-scene { background: linear-gradient(var(--paper) 70%, var(--paper-shadow) 70%); }
.pet-card.adopted { border-color: var(--green); }
.pet-card progress, .promo-active progress { accent-color: var(--green); background: var(--paper-shadow); border: 1px solid var(--brass-shadow); border-radius: 0; }
.pet-card progress::-webkit-progress-bar, .promo-active progress::-webkit-progress-bar { background: var(--paper-shadow); }
.pet-card progress::-webkit-progress-value, .promo-active progress::-webkit-progress-value { background: linear-gradient(var(--green) 0 2px, var(--green-dark) 2px); }
.promo-platform > span, .promo-platform.orange > span {
  background: var(--wood);
  border-color: var(--ink);
  box-shadow: inset 2px 2px var(--wood-light), inset -2px -2px var(--wood-lo), 2px 3px var(--paper-shadow);
}
.promo-platform .ui-pixel-icon { width: 28px; height: 28px; image-rendering: pixelated; }
.regular-unknown, .regular-empty { border-color: var(--paper-shadow); }
.regular-portrait { background: linear-gradient(0deg, var(--paper-shadow) 0 2px, transparent 2px); }
.regular-new, .style-eyebrow, .style-stage { color: var(--green-dark); }
.signature-bases [aria-pressed="true"] { background: var(--green-dark); color: var(--paper-light); outline-color: var(--gold); }
.first-service { background: var(--cream); border-color: var(--brass-shadow); box-shadow: inset 3px 0 var(--gold), 0 2px var(--wood-lo); }
.play-flow-actions { background: var(--paper-grain), var(--paper); border-top-color: var(--brass-shadow); box-shadow: inset 0 1px var(--paper-light); }
.pantry-task-context { background: var(--cream); border-bottom-color: var(--paper-shadow); }
.pantry-shortfall { box-shadow: inset 3px 0 var(--green), var(--paper-card); }

/* Native scrollbars remain usable, with the same quiet wood/paper contrast. */
.panel-scroll, .list, .modal-body, .ob-body, .region-card { scrollbar-color: var(--brass-shadow) var(--paper); scrollbar-width: thin; }

@media (min-width: 861px) {
  .tab { padding-inline: 1px; font-size: 13px; }
  .tab::before { display: block; margin: 0 auto 5px; }
}
@media (max-width: 860px) {
  .panel { box-shadow: inset 0 2px var(--wood-light); }
  .tabs { gap: 6px; }
  .tab::before { margin-right: 6px; }
  .mobile-stage-controls .day-hud { box-shadow: var(--paper-card); }
  .mobile-stage-controls:has(#open-btn:not([hidden])) .day-hud { box-shadow: none; background: var(--cream); }
  .mobile-stage-controls .cafe-style-button { box-shadow: var(--frame); }
  .mobile-stage-controls .operation-status { box-shadow: var(--paper-card); }
  .brand-name { line-height: 1.4; }
  .modal h2 { padding-bottom: 8px; }
  .modal-actions { padding-top: 8px; }
}
@media (prefers-reduced-motion: reduce) {
  .goal.done, .open-btn, .hint { animation: none; }
}

/* Six hand-drawn cabinet-tab pictograms, shared by both locales. */
.tab[data-tab="menu"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M1%205h10v2h3v5h-4v2H3v-2H1z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M2%206h8v6H3v-1H2zm9%202h2v3h-2z%22%2F%3E%3Cpath%20fill%3D%22%23c8a15e%22%20d%3D%22M2%207h8v2H2zM1%2014h12v1H1z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M4%201h1v2H4zm3%201h1v2H7z%22%2F%3E%3C%2Fsvg%3E"); }
.tab[data-tab="pantry"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M2%203h4v2h1v10H1V5h1zm7-2h5v3h1v11H8V4h1z%22%2F%3E%3Cpath%20fill%3D%22%23c8a15e%22%20d%3D%22M2%203h4v2H2zm7-2h5v2H9z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M2%206h4v8H2zm7-2h5v10H9z%22%2F%3E%3Cpath%20fill%3D%22%23627451%22%20d%3D%22M2%209h4v3H2zm7-2h5v4H9z%22%2F%3E%3Cpath%20fill%3D%22%23fff5dc%22%20d%3D%22M2%206h1v2H2zm7-2h1v2H9z%22%2F%3E%3C%2Fsvg%3E"); }
.tab[data-tab="upgrades"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M2%201h2v3h3V1h2v6H7v2H6v6H2V9H1V3h1zM11%208h3v7h-3z%22%2F%3E%3Cpath%20fill%3D%22%23c8a15e%22%20d%3D%22M2%204h2v2h3V4h1v3H6v2H3V7H2zm1%206h2v4H3z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M11%202h3v1h-1v6h-1V3h-1z%22%2F%3E%3Cpath%20fill%3D%22%23627451%22%20d%3D%22M12%209h1v5h-1z%22%2F%3E%3C%2Fsvg%3E"); }
.tab[data-tab="decor"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M6%202h4v3h3v5h-3v1h2v4H4v-4h2v-1H2V6h2V3h2z%22%2F%3E%3Cpath%20fill%3D%22%23627451%22%20d%3D%22M5%204h3v5H3V7h2zm3-1h1v6h3V6H8z%22%2F%3E%3Cpath%20fill%3D%22%239bb46b%22%20d%3D%22M5%204h2v2H5zm3-1h1v2H8z%22%2F%3E%3Cpath%20fill%3D%22%23c98c4d%22%20d%3D%22M5%2011h6v1H5zm1%201h4v2H6z%22%2F%3E%3C%2Fsvg%3E"); }
.tab[data-tab="pets"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M2%202h3v2h5V2h3v3h1v7h-2v2H3v-2H1V5h1z%22%2F%3E%3Cpath%20fill%3D%22%23c98c4d%22%20d%3D%22M3%203h1v3h7V3h1v3h1v5h-2v2H4v-2H2V6h1z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M5%209h5v3H5z%22%2F%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M4%207h1v1H4zm6%200h1v1h-1zm-3%203h1v1H7z%22%2F%3E%3Cpath%20fill%3D%22%23f0ce85%22%20d%3D%22M3%205h1v2H3z%22%2F%3E%3C%2Fsvg%3E"); }
.tab[data-tab="promotion"] { --tab-icon: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2016%2016%22%20shape-rendering%3D%22crispEdges%22%3E%3Cpath%20fill%3D%22%2339281f%22%20d%3D%22M11%201h3v13h-3v-2H8v-1H6v4H3v-4H1V5h3V4h4V3h3z%22%2F%3E%3Cpath%20fill%3D%22%23c8a15e%22%20d%3D%22M2%206h3v4H2zM4%2011h1v3H4z%22%2F%3E%3Cpath%20fill%3D%22%23f4e6c7%22%20d%3D%22M6%205h3V4h3v8H9v-2H6z%22%2F%3E%3Cpath%20fill%3D%22%23627451%22%20d%3D%22M12%202h1v11h-1z%22%2F%3E%3Cpath%20fill%3D%22%23fff5dc%22%20d%3D%22M6%205h3V4h2v1H9v1H6z%22%2F%3E%3C%2Fsvg%3E"); }

#save-session-notice {
  background: var(--paper-grain), var(--cream) !important;
  color: var(--ink) !important;
  font: 18px/1.6 'Pixelify Sans', 'Pixel ZH', ui-monospace, monospace !important;
  box-shadow: inset 0 0 0 8px var(--wood), inset 0 0 0 10px var(--wood-light);
}
html:lang(zh) #save-session-notice { font-family: 'Pixel ZH', 'Pixelify Sans', ui-monospace, monospace !important; }

/* Small brass lettering uses a darker ink than brass material shadows. */
.decor-intro .comfort, .tile-comfort { color: var(--brass-ink); }
.day-hud .chip.close-btn:hover:not(:disabled) { background: #a95240; color: var(--paper-light); }

/* Availability is shown by the object and controls, without fading readable copy. */
.row.locked, .prep-row.off { opacity: 1; }
.row.locked { background-color: var(--paper); }
.row.locked .icon, .prep-row.off .prep-select img { opacity: .55; }
.row.locked .name, .row.off-menu .name, .prep-row.off .prep-name { opacity: 1; color: var(--muted); }
.prep-row.off { background-color: var(--paper); }

/* Full-viewport café: the room keeps its original aspect ratio. All management
   chrome overlays the stage, so opening a drawer never changes its dimensions. */
body.fullscreen-cafe {
  --edge-top: calc(max(16px, env(safe-area-inset-top)) + var(--notice-height, 0px));
  --edge-right: max(16px, env(safe-area-inset-right));
  --edge-bottom: max(16px, env(safe-area-inset-bottom));
  --edge-left: max(16px, env(safe-area-inset-left));
  background: #797967;
}
body.fullscreen-cafe #app {
  position: relative; width: 100%; height: 100dvh; min-height: 0;
  display: block; padding: 0; overflow: hidden; isolation: isolate;
}
body.fullscreen-cafe .layout,
body.fullscreen-cafe .layout.panel-collapsed,
body.fullscreen-cafe .layout:has(.scene-wrap.arranging) {
  position: absolute; inset: 0; display: block; width: 100%; height: 100%;
  min-width: 0; min-height: 0; margin: 0; padding: 0;
}
body.fullscreen-cafe .stage,
body.fullscreen-cafe .layout.panel-collapsed .stage,
body.fullscreen-cafe .layout:has(.scene-wrap.arranging) .stage {
  position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0;
  padding: 0; display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
body.fullscreen-cafe .environment {
  position: absolute; inset: 0; pointer-events: none; overflow: hidden;
  background:
    linear-gradient(180deg, #b8ae8c26, transparent 48%, #3d46352a),
    repeating-linear-gradient(0deg, transparent 0 95px, #45544417 95px 98px),
    repeating-linear-gradient(90deg, transparent 0 127px, #45544412 127px 130px),
    #8c9278;
}
body.fullscreen-cafe .environment::before {
  content: ''; position: absolute; inset: 0; opacity: .65;
  background:
    linear-gradient(90deg, #6d775d 0 5%, transparent 5% 95%, #6d775d 95%),
    linear-gradient(180deg, #b4aa8c 0 18%, #837d65 18% 19%, transparent 19% 81%, #9b9278 81% 84%, #b0a58b 84% 100%);
}
body.fullscreen-cafe .environment::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 16%;
  background:
    repeating-linear-gradient(90deg, transparent 0 95px, #80775f33 95px 98px),
    repeating-linear-gradient(0deg, transparent 0 27px, #80775f26 27px 30px);
  border-top: 4px solid #d4c7a83b;
}
body.fullscreen-cafe .scene-wrap { position: relative; z-index: 1; flex: 0 0 auto; }
body.fullscreen-cafe #scene { border: 0; box-shadow: none; }
body.fullscreen-cafe .stage-sign,
body.fullscreen-cafe .stage-stats { display: none !important; }

/* Transparent overlay containers never intercept clicks in the room. */
body.fullscreen-cafe .hud {
  position: absolute; inset: 0; z-index: 8; display: block;
  padding: 0; border: 0; background: none; box-shadow: none; pointer-events: none;
}
body.fullscreen-cafe .hud .brand {
  position: absolute; top: var(--edge-top); left: var(--edge-left);
  max-width: min(310px, calc(100% - 180px)); min-height: 44px;
  padding: 7px 12px; background: var(--wood-planks), var(--wood);
  box-shadow: var(--frame), 2px 4px #39281f30; pointer-events: auto;
}
body.fullscreen-cafe .hud .money {
  position: absolute; top: var(--edge-top); right: var(--edge-right);
  width: 136px; min-height: 62px; padding: 5px 10px; pointer-events: auto;
}
body.fullscreen-cafe .money .coins { min-height: 32px; font-size: 24px; }
body.fullscreen-cafe .hud-buttons { position: absolute; inset: 0; display: block; pointer-events: none; }
body.fullscreen-cafe .hud-buttons button { position: absolute; min-height: 44px; pointer-events: auto; }
body.fullscreen-cafe #settings-btn { left: var(--edge-left); bottom: var(--edge-bottom); width: 44px; }
body.fullscreen-cafe #panel-toggle { right: var(--edge-right); bottom: var(--edge-bottom); padding-inline: 16px; }
body.fullscreen-cafe .cafe-status-bar {
  position: absolute; z-index: 8; top: calc(var(--edge-top) + 74px); right: var(--edge-right);
  display: flex; flex-direction: column; align-items: stretch; gap: 8px;
  width: 136px; border: 0; background: none; box-shadow: none; pointer-events: none;
}
body.fullscreen-cafe .cafe-status-bar button {
  pointer-events: auto; min-height: 44px; padding: 6px 8px; font-size: 12px;
  border: 0; background: var(--paper-grain), var(--cream);
  box-shadow: var(--paper-card); gap: 5px;
}
body.fullscreen-cafe #reputation-traffic { display: none; }
body.fullscreen-cafe .reputation-more { margin-left: auto; }
body.fullscreen-cafe .day-hud {
  z-index: 7; top: calc(var(--edge-top) + 58px); left: var(--edge-left);
  right: auto; bottom: auto; max-width: min(355px, calc(100% - 185px));
  min-height: 48px; padding: 5px 8px; gap: 8px; flex-wrap: wrap; justify-content: flex-start;
{
  "name": "tiny-bean-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/subset-font.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/subset-font.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "font": "node scripts/subset-font.mjs",
    "balance": "vitest run scripts/balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:lab": "ECONOMY_LAB=1 vitest run scripts/economy-lab.test.ts --silent=false --disableConsoleIntercept",
    "balance:compare": "node scripts/compare-economy.mjs",
    "balance:frontier": "INVESTMENT_FRONTIER=1 vitest run scripts/investment-frontier.test.ts --silent=false --disableConsoleIntercept",
    "balance:long": "ECONOMY_LONG_HORIZON=1 vitest run scripts/economy-long-horizon.test.ts --silent=false --disableConsoleIntercept",
    "balance:long-supplement": "ECONOMY_LONG_HORIZON_SUPPLEMENT=1 vitest run scripts/economy-long-horizon-supplement.test.ts --silent=false --disableConsoleIntercept",
    "balance:fixed-clock": "FIXED_CLOCK=1 vitest run scripts/economy-fixed-clock.test.ts --silent=false --disableConsoleIntercept",
    "balance:recovery": "EMERGENCY_RECOVERY=1 EMERGENCY_RECOVERY_LABEL=emergency-recovery-v2 vitest run scripts/economy-recovery.test.ts --silent=false --disableConsoleIntercept",
    "balance:restore": "node scripts/restore-economy-evidence.mjs",
    "balance:routes": "vitest run scripts/cafe-style-balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:routes:full": "CAFE_STYLE_LAB=1 vitest run scripts/cafe-style-balance.test.ts --silent=false --disableConsoleIntercept",
    "balance:routes:progression": "CAFESTYLE_PROGRESSION=1 vitest run scripts/cafe-style-progression.test.ts --silent=false --disableConsoleIntercept"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "phaser": "^4.2.1"
  }
}
