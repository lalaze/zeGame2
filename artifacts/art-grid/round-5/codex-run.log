.row.locked, .prep-row.off { opacity: 1; }
.row.locked { background-color: var(--paper); }
.row.locked .icon, .prep-row.off .prep-select img { opacity: .55; }
.row.locked .name, .row.off-menu .name, .prep-row.off .prep-name { opacity: 1; color: var(--muted); }
.prep-row.off { background-color: var(--paper); }

/* Full-viewport café: the room keeps its original aspect ratio. All management
   chrome overlays the stage, so opening a drawer never changes its dimensions. */
body.fullscreen-cafe {
  --edge-top: calc(max(16px, env(safe-area-inset-top)) + var(--notice-height, 0px));
  --edge-right: max(16px, env(safe-area-inset-right));
  --edge-bottom: max(16px, env(safe-area-inset-bottom));
  color: var(--cream);
  font-size: 16px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-weight: 600;
  text-shadow: 2px 2px 0 var(--ink);
  box-shadow: 0 -3px 0 0 var(--ink), -3px 0 0 0 var(--ink), 3px 0 0 0 var(--ink), inset 0 3px 0 var(--wood-hi);
  margin: 3px 3px 0;
}

.tab.active {
  background: var(--paper);
  color: var(--ink);
  text-shadow: none;
  box-shadow: 0 -3px 0 0 var(--ink), -3px 0 0 0 var(--ink), 3px 0 0 0 var(--ink), inset 0 3px 0 var(--cream),
    0 3px 0 0 var(--paper);
  position: relative;
  z-index: 1;
}

.buy-amount {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px 4px;
  font-size: 14px;
  color: var(--muted);
}

.chip {
  border: none;
  padding: 2px 10px;
  background: var(--cream);
  color: var(--ink);
  box-shadow: var(--border);
  margin: 0 4px;
}

.chip.active {
  background: var(--ink);
  color: var(--gold);
}

