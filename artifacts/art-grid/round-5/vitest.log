        c = pixelSprite(ESPRESSO, {
          B: body.base, b: body.lo, L: body.hi, D: body.dark,
          C: chrome.base, c: chrome.lo, X: chrome.hi,
          k: '#3a2a2a', n: '#4a3434', g: '#fdf6ec', r: '#d9384a', w: '#fdf6ec', W: '#dccdb9',
