          ctx.globalAlpha = 0.05;
          this.r(0, FLOOR_Y, 3 * (4 - i), H - FLOOR_Y, artRamp('walnut')[0]);
          this.r(SCENE_W - 3 * (4 - i), FLOOR_Y, 3 * (4 - i), H - FLOOR_Y, artRamp('walnut')[0]);
