          ctx.globalAlpha = 0.35;
          this.r(x, top, 114, 1, '#a97954');
          this.r(x, bottom - 1, 114, 1, '#a97954');
          this.r(x, top, 1, bottom - top, '#a97954');
          this.r(x + 113, top, 1, bottom - top, '#a97954');
