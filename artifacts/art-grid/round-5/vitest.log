          this.r(COUNTER.x + row * .5, COUNTER.bottom + row, COUNTER.w + COUNTER_GATE.w, 1, artRamp('walnut')[0]);
        }
        ctx.globalAlpha = 0.24;
        this.r(COUNTER.x, COUNTER.bottom, COUNTER.w + COUNTER_GATE.w, 1, artRamp('walnut')[0]);
        for (let i = 0; i < 4; i++) {
