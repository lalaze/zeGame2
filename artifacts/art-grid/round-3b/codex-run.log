      r(x, 51, 8, 2, '#f1d692');
      r(x + 2, 53, 1, 4, '#c8a15e');
    }
    gardenBox(ctx, 118, 64, 18, false);
    r(181, 62, 14, 2, '#7e5b45'); r(182, 60, 12, 2, '#d2ad78');
    r(183, 58, 11, 2, '#6d7c5b');
    for (const x of [90, 219]) wallLantern(ctx, x, 31);
