    r(157, 23, 5, 43, '#6f492e'); r(158, 24, 2, 41, '#e2c18b');
    r(112, 43, 96, 4, '#6f492e'); r(113, 43, 94, 1, '#e2c18b');
    timberBeam(ctx, 106, 67, 108, 6);
