  shape(1.5,sage[3]); shape(2,floor[1]); shape(2.5,cream[2]); shape(3,sage[2]);
  const diamond=(cx:number,cy:number,color:string)=>{
    r(cx-1,cy-3,2,2,color);r(cx-3,cy-1,2,2,color);
    r(cx+1,cy-1,2,2,color);r(cx-1,cy+1,2,2,color);
