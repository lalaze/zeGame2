      const s = mainShadowState(this.currentLight);
      if (cast && s.strength > 0) {
        const key = baked(this.textures, `main-cast-${w}-${s.reach}-${s.strength}`, w + 32, 40,
          ctx => paintCastShade(ctx, half + 2, 7, w, s.reach, s.strength));
