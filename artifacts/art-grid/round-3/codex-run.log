  /** Which way someone faces: where they're walking, or `standing` when still. */
  private facing(w: Walker, standing: Facing): Facing {
    const dx = w.tx - w.x;
    const dy = w.ty - w.y;
    if (dx !== 0 || dy !== 0) {
      if (Math.abs(dx) > Math.abs(dy)) return dx > 0 ? 'right' : 'left';
      return dy > 0 ? 'down' : 'up';
    }
    return standing;
  }
