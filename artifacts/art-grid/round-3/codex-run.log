+import type { AreaId } from '../game/regions';
+import type { Sun } from './lighting';
+import { beam } from './lighting';
+import { artRamp, artRect, mainTimber } from './main-room-surfaces';
+import { paintContactShade } from './main-room-lighting';
+
+type Ctx = CanvasRenderingContext2D;
+const cream = artRamp('cloth-7'), oak = artRamp('oak'), walnut = artRamp('walnut');
+
+export function extensionFloor(ctx: Ctx, area: AreaId, top: number, height: number): void {
+  const floor = artRamp('floor');
+  const colors = area === 'greenhouse' ? [floor[0], floor[0], artRamp('terracotta')[2], floor[2], floor[3]] : floor;
+  const tileW = area === 'terrace' ? 40 : 24, tileH = area === 'terrace' ? 20 : 24;
+  artRect(ctx, 0, top, 320, height - top, colors[1]);
+  ctx.save(); ctx.beginPath(); ctx.rect(0, top, 320, height - top); ctx.clip();
+  for (let row = 0, y = top; y < height; y += tileH, row++) {
+    for (let x = row % 2 ? -tileW / 2 : 0; x < 320; x += tileW) {
+      artRect(ctx, x + .5, y + .5, tileW - 1, tileH - 1, colors[3]);
+      artRect(ctx, x + 1, y + 1, tileW - 2, .5, colors[4]);
+      artRect(ctx, x + 1, y + 1, .5, tileH - 2, colors[4]);
+      artRect(ctx, x + 1, y + tileH - 1.5, tileW - 2, .5, colors[2]);
+      if ((row + Math.floor(x / tileW)) % 4 === 0) {
+        artRect(ctx, x + 5, y + tileH - 4, 7, .5, colors[2]);
+        artRect(ctx, x + 6, y + tileH - 4.5, 4, .5, colors[4]);
+      }
+    }
+  }
+  ctx.restore();
+}
+
+export function extensionRunner(ctx: Ctx, area: AreaId, x: number, y: number, w: number, h: number, dir: 'h' | 'v'): void {
+  const colors = artRamp(area === 'reading' ? 'gingham' : area === 'terrace' ? 'cloth-1' : 'sage');
+  artRect(ctx, x, y, w, h, colors[0]);
+  artRect(ctx, x + .5, y + .5, w - 1, h - 1, oak[2]);
+  artRect(ctx, x + 1, y + 1, w - 2, h - 2, cream[1]);
+  artRect(ctx, x + 2, y + 2, w - 4, h - 4, colors[1]);
+  artRect(ctx, x + 3, y + 3, w - 6, h - 6, area === 'reading' ? cream[2] : colors[2]);
+  const count = dir === 'h' ? w : h;
+  for (let step = 9; step < count - 6; step += 20) {
+    const cx = dir === 'h' ? x + step : x + w / 2;
+    const cy = dir === 'h' ? y + h / 2 : y + step;
+    artRect(ctx, cx - 1, cy - 2, 2, 1, colors[0]);
+    artRect(ctx, cx - 2, cy - 1, 4, 2, colors[1]);
+    artRect(ctx, cx - 1, cy + 1, 2, 1, colors[0]);
+  }
+}
+
+export function readingDoor(ctx: Ctx, floor: number): void {
+  artRect(ctx, 139, 12, 42, floor - 8, walnut[0]);
+  artRect(ctx, 144, 18, 32, floor - 18, artRamp('sage')[0]);
+  const sage = artRamp('sage'), tile = artRamp('floor');
+  artRect(ctx, 146, 20, 28, floor - 20, sage[1]);
+  artRect(ctx, 148, 21, 24, 32, artRamp('sky')[1]);
+  artRect(ctx, 159, 21, 1.5, 33, sage[0]);
+  artRect(ctx, 148, 38, 24, 1, sage[1]);
+  artRect(ctx, 146, 54, 28, floor - 54, tile[2]);
+  for (let top = 56; top < floor - 2; top += 7) {
+    artRect(ctx, 146, top, 28, .5, tile[0]);
+    artRect(ctx, top % 2 ? 154 : 164, top, .5, 7, tile[0]);
+  }
+  for (const x of [149, 169]) {
+    artRect(ctx, x - 2, 50, 5, 6, artRamp('terracotta')[0]);
+    artRect(ctx, x - 1.5, 50, 4, 5, artRamp('terracotta')[2]);
+    artRect(ctx, x, 41, .5, 9, sage[0]);
+    for (let row = 0; row < 3; row++) {
+      artRect(ctx, x - 2, 42 + row * 2, 2.5, 1, sage[2]);
+      artRect(ctx, x + .5, 41 + row * 2, 2, 1, sage[3]);
+    }
+  }
+  mainTimber(ctx, 139, 13, 5, floor - 9, true);
+  mainTimber(ctx, 176, 13, 5, floor - 9, true);
+  mainTimber(ctx, 137, 10, 46, 8);
+  mainTimber(ctx, 144, floor - 2, 32, 3);
+  artRect(ctx, 146, floor - 1.5, 28, .5, cream[2]);
+}
+
+export function readingFurnishing(ctx: Ctx, kind: 'armchair' | 'lamp', cx: number, foot: number): void {
+  const r = (x: number, y: number, w: number, h: number, color: string) => artRect(ctx, cx + x, foot + y, w, h, color);
+  paintContactShade(ctx, cx, foot, kind === 'lamp' ? 10 : 24, .18);
+  if (kind === 'lamp') {
+    r(-4, -1, 8, 1.5, walnut[0]); r(-3, -2, 6, 1, oak[3]);
+    r(-.5, -24, 1, 22, walnut[0]); r(-.5, -23, .5, 20, oak[4]);
+    r(-1, -33, 2, 1, oak[4]);
+    for (let row = 0; row < 16; row++) {
+      const half = 2 + Math.floor(row / 4);
+      r(-half, -32 + row / 2, half * 2, .5, walnut[0]);
+      r(-half + .5, -32 + row / 2, half * 2 - 1, .5, cream[row < 2 ? 1 : 2]);
+      if (row > 2) r(half - 1.5, -32 + row / 2, 1, .5, cream[1]);
+    }
+    r(-5, -24, 10, .5, oak[3]); r(-4.5, -23.5, 9, .5, cream[2]);
+    return;
+  }
+  const cloth = artRamp('cloth-5');
+  r(-10, -4, 2, 5, walnut[0]); r(8, -4, 2, 5, walnut[0]);
+  for (let row = 0; row < 34; row++) {
+    const inset = row < 2 ? 2 : row < 4 ? 1 : 0;
+    r(-9 + inset, -26 + row / 2, 17 - inset * 2, .5, walnut[0]);
+    r(-8.5 + inset, -25.5 + row / 2, 16 - inset * 2, .5, cloth[0]);
+    r(-8 + inset, -25 + row / 2, 13.5 - inset * 2, .5, cloth[1]);
+  }
+  r(-6, -25, 10, .5, cloth[2]); r(-7.5, -23.5, .5, 9, cloth[2]);
+  r(-.5, -20, 1, .5, cloth[0]); r(0, -19.5, .5, 1, cloth[2]);
+  for (const [x, top] of [[-12, -15], [6, -14]] as const) {
+    r(x + 1, top - .5, 4, .5, walnut[0]); r(x, top, 6, 11, walnut[0]);
+    r(x + .5, top, 5, 10.5, cloth[0]); r(x + .5, top + .5, 4, 8.5, cloth[1]);
+    r(x + 1, top, 3, .5, cloth[2]); r(x + 1, top + 1, .5, 5, cloth[2]);
+    r(x + 3.5, top + 7, .5, 2, cloth[0]);
+  }
+  r(-6, -10, 12, 6, cloth[0]); r(-6, -10, 11, 3, cloth[1]);
+  r(-5.5, -10, 10, .5, cloth[2]); r(-5, -7, 10, .5, cloth[2]);
+  r(-8, -3.5, 16, 1, walnut[2]);
+}
+
+export function extensionRunnerJunction(ctx: Ctx, area: AreaId, y: number): void {
+  const colors = artRamp(area === 'reading' ? 'gingham' : area === 'terrace' ? 'cloth-1' : 'sage');
+  artRect(ctx, 145, y - 7, 30, 14, area === 'reading' ? cream[2] : colors[2]);
+  artRect(ctx, 159, y - 2, 2, 1, colors[0]);
+  artRect(ctx, 158, y - 1, 4, 2, colors[1]);
+  artRect(ctx, 159, y + 1, 2, 1, colors[0]);
+}
+
+export function extensionLampPool(ctx: Ctx, radius: number, tint: string): void {
+  ctx.save(); ctx.fillStyle = tint;
+  for (let row = 0; row < radius * 2; row += .5) for (let col = 0; col < radius * 2; col += .5) {
+    const distance = Math.hypot(col + .25 - radius, row + .25 - radius) / radius;
+    if (distance >= 1) continue;
+    ctx.globalAlpha = .28 * (1 - distance * distance) ** 3;
+    ctx.fillRect(col, row, .5, .5);
+  }
+  ctx.restore();
+}
+
+export function extensionWindowPatch(ctx: Ctx, x: number, width: number, floor: number, sun: Sun): void {
+  if (sun.elevation <= 0 || sun.strength <= 0) return;
+  const { lean, length } = beam(sun);
+  ctx.save(); ctx.fillStyle = artRamp('wall')[4];
+  for (let row = 0; row < length; row += .5) {
+    const progress = row / length;
+    if (progress > .36 && progress < .40) continue;
+    ctx.globalAlpha = sun.strength * .38 * Math.min(1, (1 - progress) * 12);
+    for (let pane = 0; pane < 2; pane++) {
+      artRect(ctx, x + progress * lean + pane * width / 2, floor + row, width / 2 - 2, .5, artRamp('wall')[4]);
+    }
+  }
+  ctx.restore();
+}
