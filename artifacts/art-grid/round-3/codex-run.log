+function record(paint: (ctx: CanvasRenderingContext2D) => void) {
+  const marks: { x: number; y: number; w: number; h: number; color: string; alpha: number }[] = [];
+  const stack: number[] = [];
+  const ctx = {
+    fillStyle: '', globalAlpha: 1,
+    save() { stack.push(this.globalAlpha); }, restore() { this.globalAlpha = stack.pop()"'!; },
+    beginPath() {}, rect() {}, clip() {},
+    fillRect(x: number, y: number, w: number, h: number) { marks.push({ x, y, w, h, color: this.fillStyle, alpha: this.globalAlpha }); },
+  } as unknown as CanvasRenderingContext2D;
+  paint(ctx); return marks;
+}
+
+describe('"'extension room native artwork', () => {
