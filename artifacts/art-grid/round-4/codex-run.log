@@ -0,0 +1,83 @@
+import { decodePng } from './pixel-conform.mjs';
+
+export class RasterCanvas {
+  constructor() { this.width = 1; this.height = 1; this.context = new RasterContext(this); }
+  getContext() { return this.context; }
+  get pixels() {
