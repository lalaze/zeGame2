+fs.writeFileSync(directory + '/offline-labels.json', JSON.stringify(labels));
+fs.writeFileSync(directory + '/offline-metrics.json', JSON.stringify({ nativeFrames, offPalettePixels, rows }, null, 2) + '\\n');
