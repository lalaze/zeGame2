      for (let dx = -10; dx <= 10; dx += 4) {
        const dy = Math.round(Math.sqrt(1 - (dx / RX) ** 2) * RY);
        r(cx + dx, cy + dy + DROP - 1, 1, 1, '#f7dbae');
        r(cx + dx + 1, cy + dy + 2, 1, 2, '#8e493a');
