          ctx.closePath();
          ctx.clip();
          const cropTop = source.height * 65 / 235;
          const rs = source.sourceScale;
          ctx.drawImage(source.source, 0, cropTop * rs, source.contentWidth, (source.height - cropTop) * rs,
            x, y + height * 65 / 235, width, height * (1 - 65 / 235));
