        const shelfY = cy + ch - 4;
        this.r(x, shelfY, w, 1, '#c0824f');
    
        const bakery = menuItems(state).filter((m) => !isDrink(m.category)).slice(0, 5);
        const slots = Math.max(3, bakery.length);
        const slot = w / slots;
