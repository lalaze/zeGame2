        box.fillStyle(fill, 0.3 + Math.sin(t * 6) * 0.08);
        const outline = polygon(rect);
        box.fillPoints(outline, true);
        box.lineStyle(1, fill, 1);
        box.strokePoints(outline, true);
      }
