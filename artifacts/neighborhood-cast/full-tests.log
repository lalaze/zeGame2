+     const camera = this.cameras.main;
+     camera.setZoom(this.backing * view.zoom);
+     const zoom = this.backing * view.zoom;
+     const left = viewX - this.viewportFrame.x / zoom;
+     const top = viewY - this.viewportFrame.y / zoom;
